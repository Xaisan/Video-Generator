<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wan 2.2 I2V — Video Generator</title>
  <link rel="stylesheet" href="/static/style.css" />
</head>
<body>
  <div id="app">
    <!-- ─── Sidebar ─────────────────────────────────────────── -->
    <aside id="sidebar">
      <div class="sidebar-header">
        <h2>Sessions</h2>
        <div class="sidebar-header-actions">
          <button id="btn-theme" class="btn btn-xs btn-ghost" title="Toggle dark/light mode">🌙</button>
          <button id="btn-new" class="btn btn-sm btn-primary" title="New generation (Ctrl+N)">+ New</button>
        </div>
      </div>
      <div id="session-list" class="session-list"></div>
      <div class="sidebar-footer">
        <div id="vram-bar-sidebar" class="vram-bar">
          <div class="vram-fill" style="width:0%"></div>
          <span class="vram-label">VRAM: —</span>
        </div>
        <div class="shortcut-hints">
          <span class="kbd">Enter</span> Generate &nbsp;
          <span class="kbd">Esc</span> Cancel
        </div>
      </div>
    </aside>

    <!-- ─── Main ────────────────────────────────────────────── -->
    <main id="main">
      <!-- Panel: New/Resume Generation -->
      <section id="panel-generate" class="panel">
        <h1>Image-to-Video Generation</h1>

        <div class="form-grid">
          <!-- Left column: Image upload -->
          <div class="form-col">
            <div class="form-group">
              <label>Input Image</label>
              <div id="drop-zone" class="drop-zone">
                <img id="preview-img" src="" alt="" style="display:none" />
                <p id="drop-text">Drop image here or click to browse</p>
                <input type="file" id="file-input" accept="image/*" style="display:none" />
              </div>
              <input type="hidden" id="input-image-path" value="" />
            </div>
          </div>

          <!-- Right column: Parameters -->
          <div class="form-col">
            <div class="form-group">
              <label for="prompt">Prompt</label>
              <textarea id="prompt" rows="3" placeholder="Describe the video motion...">{{ config.get('prompt', '') }}</textarea>
            </div>
            <div class="form-group">
              <label for="negative-prompt">Negative Prompt</label>
              <textarea id="negative-prompt" rows="2" placeholder="Things to avoid...">{{ config.get('negative_prompt', '') }}</textarea>
            </div>

            <div class="form-row">
              <div class="form-group slider-group">
                <label for="width">Width <span class="slider-value" id="width-val">{{ config.get('width', 832) }}</span></label>
                <input type="range" id="width" value="{{ config.get('width', 832) }}" min="256" max="1920" step="16" />
              </div>
              <div class="form-group slider-group">
                <label for="height">Height <span class="slider-value" id="height-val">{{ config.get('height', 480) }}</span></label>
                <input type="range" id="height" value="{{ config.get('height', 480) }}" min="256" max="1080" step="16" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group slider-group">
                <label for="duration">Duration (s) <span class="slider-value" id="duration-val">{{ config.get('duration', 5.0) }}</span></label>
                <input type="range" id="duration" value="{{ config.get('duration', 5.0) }}" min="1" max="20" step="0.5" />
              </div>
              <div class="form-group slider-group">
                <label for="fps">Generation FPS <span class="slider-value" id="fps-val">{{ config.get('fps', 16) }}</span></label>
                <input type="range" id="fps" value="{{ config.get('fps', 16) }}" min="8" max="30" step="1" />
              </div>
              <div class="form-group">
                <label>Frames <span class="slider-value computed-value" id="frames-computed">81</span></label>
                <div class="computed-hint">auto: duration × fps → 4k+1</div>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group slider-group">
                <label for="steps">Steps <span class="slider-value" id="steps-val">{{ config.get('num_inference_steps', 8) }}</span></label>
                <input type="range" id="steps" value="{{ config.get('num_inference_steps', 8) }}" min="1" max="50" step="1" />
              </div>
              <div class="form-group slider-group">
                <label for="cfg">CFG Scale <span class="slider-value" id="cfg-val">{{ config.get('guidance_scale', 2.0) }}</span></label>
                <input type="range" id="cfg" value="{{ config.get('guidance_scale', 2.0) }}" min="1" max="20" step="0.1" />
              </div>
              <div class="form-group slider-group">
                <label for="cfg2">CFG Scale 2 <span class="slider-value" id="cfg2-val">{{ config.get('guidance_scale_2', 2.0) }}</span></label>
                <input type="range" id="cfg2" value="{{ config.get('guidance_scale_2', 2.0) }}" min="1" max="20" step="0.1" />
              </div>
              <div class="form-group slider-group">
                <label for="flow-shift">Flow Shift <span class="slider-value" id="flow-shift-val">{{ config.get('flow_shift', 8.0) }}</span></label>
                <input type="range" id="flow-shift" value="{{ config.get('flow_shift', 8.0) }}" min="0" max="30" step="0.5" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="seed">Seed</label>
                <div class="seed-row">
                  <input type="number" id="seed" value="{{ config.get('seed', 42) }}" min="-1" max="999999999" />
                  <button class="btn btn-xs btn-ghost" onclick="document.getElementById('seed').value=Math.floor(Math.random()*999999999)" title="Randomize seed">🎲</button>
                </div>
              </div>
              <div class="form-group slider-group">
                <label for="output-fps">Output FPS <span class="slider-value" id="output-fps-val">{{ config.get('output_fps', 24) }}</span></label>
                <input type="range" id="output-fps" value="{{ config.get('output_fps', 24) }}" min="8" max="60" step="1" />
                <div class="computed-hint" id="interp-hint">RIFE: 16→24fps</div>
              </div>
              <div class="form-group chk">
                <label>
                  <input type="checkbox" id="enable-upscale" />
                  Enable 4× Upscale
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- LoRA scales -->
        <details class="lora-section" open>
          <summary>LoRA Weights</summary>
          <div id="lora-scales">
            {% for lora in loras %}
            <div class="form-group lora-item slider-group">
              <label title="{{ lora.path }}">{{ lora.path | basename }} <span class="slider-value lora-val">{{ lora.scale }}</span></label>
              <input type="range" class="lora-scale" data-lora="{{ loop.index0 }}"
                     value="{{ lora.scale }}" min="0" max="3" step="0.1" />
            </div>
            {% endfor %}
          </div>
        </details>

        <div class="form-actions">
          <button id="btn-generate" class="btn btn-primary btn-lg">🚀 Generate</button>
        </div>
      </section>

      <!-- Panel: Session Detail / Progress -->
      <section id="panel-session" class="panel" style="display:none">
        <div class="session-header">
          <h2 id="session-title">Session</h2>
          <div class="session-actions">
            <button id="btn-clone" class="btn btn-ghost btn-sm" title="Clone params to generate panel">📋 Clone</button>
            <button id="btn-cancel" class="btn btn-danger btn-sm" style="display:none">⏹ Cancel</button>
            <button id="btn-back" class="btn btn-ghost btn-sm">← Back</button>
            <button id="btn-delete-session" class="btn btn-danger btn-sm">🗑 Delete</button>
          </div>
        </div>

        <!-- Elapsed / ETA timer -->
        <div id="timer-bar" class="timer-bar" style="display:none">
          <span id="timer-elapsed">⏱ 0:00</span>
          <span id="timer-eta" class="timer-eta"></span>
        </div>

        <!-- Step pipeline -->
        <div id="step-pipeline" class="step-pipeline">
          {% for step in step_order %}
          <div class="step-card" data-step="{{ step }}">
            <div class="step-icon">●</div>
            <div class="step-name">{{ step }}</div>
            <div class="step-status">pending</div>
            <div class="step-progress-mini">
              <div class="step-progress-fill"></div>
            </div>
            <div class="step-time"></div>
            <button class="btn btn-xs btn-ghost btn-resume" data-step="{{ step }}" title="Resume from this step">▶</button>
          </div>
          {% endfor %}
        </div>

        <!-- VRAM detail bar -->
        <div id="vram-detail" class="vram-detail">
          <div class="vram-detail-bar">
            <div class="vram-detail-reserved" style="width:0%"></div>
            <div class="vram-detail-allocated" style="width:0%"></div>
          </div>
          <div class="vram-detail-labels">
            <span class="vram-alloc-label">Allocated: —</span>
            <span class="vram-reserved-label">Reserved: —</span>
            <span class="vram-total-label">Total: —</span>
          </div>
        </div>

        <!-- Progress bar -->
        <div id="progress-section" class="progress-section" style="display:none">
          <div class="progress-bar">
            <div id="progress-fill" class="progress-fill" style="width:0%"></div>
          </div>
          <div id="progress-msg" class="progress-msg">Waiting…</div>
        </div>

        <!-- Session info -->
        <div id="session-info" class="session-info">
          <div class="info-grid">
            <div><strong>Prompt:</strong> <span id="info-prompt">—</span></div>
            <div><strong>Size:</strong> <span id="info-size">—</span></div>
            <div><strong>Steps:</strong> <span id="info-steps">—</span></div>
            <div><strong>Seed:</strong> <span id="info-seed">—</span></div>
            <div><strong>CFG:</strong> <span id="info-cfg">—</span></div>
            <div><strong>Status:</strong> <span id="info-status">—</span></div>
            <div id="info-error-row"><strong>Error:</strong> <span id="info-error" class="error-text">—</span></div>
          </div>
        </div>

        <!-- Input image preview in session detail -->
        <div id="input-image-section" class="input-image-section" style="display:none">
          <h3>Input Image</h3>
          <img id="session-input-img" src="" alt="Input image" />
        </div>

        <!-- Video preview with tabs (Original / Upscaled / Compare) -->
        <div id="video-section" class="video-section" style="display:none">
          <div class="video-tabs">
            <button class="video-tab active" data-tab="original">Original</button>
            <button class="video-tab" data-tab="upscaled" id="tab-upscaled" style="display:none">Upscaled</button>
            <button class="video-tab" data-tab="compare" id="tab-compare" style="display:none">Compare</button>
          </div>

          <!-- Original video -->
          <div class="video-tab-content active" data-tab="original">
            <video id="video-player" controls loop muted></video>
            <div class="video-actions">
              <a id="video-download" href="#" class="btn btn-sm btn-primary" download>⬇ Download Original</a>
            </div>
          </div>

          <!-- Upscaled video -->
          <div class="video-tab-content" data-tab="upscaled">
            <video id="video-player-upscaled" controls loop muted></video>
            <div class="video-actions">
              <a id="video-download-upscaled" href="#" class="btn btn-sm btn-primary" download>⬇ Download Upscaled</a>
            </div>
          </div>

          <!-- Side-by-side comparison -->
          <div class="video-tab-content" data-tab="compare">
            <div class="video-compare">
              <div class="video-compare-col">
                <h4>Original</h4>
                <video id="video-compare-orig" controls loop muted></video>
              </div>
              <div class="video-compare-col">
                <h4>Upscaled</h4>
                <video id="video-compare-up" controls loop muted></video>
              </div>
            </div>
          </div>
        </div>

        <!-- Log viewer -->
        <details id="log-viewer" class="log-viewer">
          <summary>📜 Pipeline Logs</summary>
          <div id="log-content" class="log-content"></div>
        </details>
      </section>
    </main>
  </div>

  <!-- Toast container -->
  <div id="toast-container" class="toast-container"></div>

  <script src="/static/app.js"></script>
</body>
</html>
