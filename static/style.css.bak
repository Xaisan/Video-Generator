/* ── Wan 2.2 I2V – Web UI Styles ─────────────────────────────────── */

/* ── Theme variables ──────────────────────────────────────────────── */

[data-theme="dark"] {
  --bg:          #0d1117;
  --bg-sidebar:  #161b22;
  --bg-card:     #1c2128;
  --bg-hover:    #252c35;
  --bg-input:    #0d1117;
  --border:      #30363d;
  --text:        #e6edf3;
  --text-dim:    #8b949e;
  --text-muted:  #484f58;
  --accent:      #58a6ff;
  --accent-dim:  #1f6feb;
  --success:     #3fb950;
  --warning:     #d29922;
  --danger:      #f85149;
  --radius:      8px;
  --radius-sm:   4px;
  --shadow:      0 2px 8px rgba(0,0,0,.3);
  --log-bg:      #010409;
  --toast-bg:    #21262d;
}

[data-theme="light"] {
  --bg:          #ffffff;
  --bg-sidebar:  #f6f8fa;
  --bg-card:     #f0f2f5;
  --bg-hover:    #e8eaed;
  --bg-input:    #ffffff;
  --border:      #d0d7de;
  --text:        #1f2328;
  --text-dim:    #656d76;
  --text-muted:  #8b949e;
  --accent:      #0969da;
  --accent-dim:  #0550ae;
  --success:     #1a7f37;
  --warning:     #9a6700;
  --danger:      #cf222e;
  --radius:      8px;
  --radius-sm:   4px;
  --shadow:      0 2px 8px rgba(0,0,0,.1);
  --log-bg:      #f6f8fa;
  --toast-bg:    #ffffff;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  overflow: hidden;
  height: 100vh;
}

#app {
  display: flex;
  height: 100vh;
}

/* ── Sidebar ──────────────────────────────────────────────────────── */

#sidebar {
  width: 300px;
  min-width: 300px;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid var(--border);
}
.sidebar-header h2 { font-size: 16px; font-weight: 600; }
.sidebar-header-actions { display: flex; gap: 6px; align-items: center; }

.session-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}

.session-item {
  display: flex;
  gap: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  margin-bottom: 4px;
  transition: background .15s;
  border: 1px solid transparent;
  align-items: flex-start;
}
.session-item:hover { background: var(--bg-hover); }
.session-item.active {
  background: var(--bg-card);
  border-color: var(--accent-dim);
}

/* Thumbnail in sidebar */
.si-thumb {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  flex-shrink: 0;
  background: var(--bg);
}
.si-thumb-placeholder {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: var(--text-muted);
}

.si-details { flex: 1; min-width: 0; }

.session-item .si-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.session-item .si-id {
  font-size: 12px;
  font-family: monospace;
  color: var(--text-dim);
}
.session-item .si-status {
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 10px;
  font-weight: 500;
}
.si-status.done { background: #0d3321; color: var(--success); }
.si-status.running { background: #3d2a06; color: var(--warning); }
.si-status.failed { background: #3d0e0e; color: var(--danger); }
.si-status.pending { background: #1c2128; color: var(--text-muted); }
.si-status.cancelled { background: #1c2128; color: var(--text-muted); }

[data-theme="light"] .si-status.done { background: #dafbe1; color: var(--success); }
[data-theme="light"] .si-status.running { background: #fff8c5; color: var(--warning); }
[data-theme="light"] .si-status.failed { background: #ffebe9; color: var(--danger); }
[data-theme="light"] .si-status.pending { background: var(--bg-card); color: var(--text-muted); }
[data-theme="light"] .si-status.cancelled { background: var(--bg-card); color: var(--text-muted); }

.session-item .si-prompt {
  font-size: 13px;
  margin-top: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-dim);
}
.session-item .si-date {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
}

.sidebar-footer {
  padding: 12px 16px;
  border-top: 1px solid var(--border);
}

.shortcut-hints {
  margin-top: 8px;
  font-size: 11px;
  color: var(--text-muted);
  text-align: center;
}
.kbd {
  display: inline-block;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 0 4px;
  font-size: 10px;
  font-family: monospace;
  line-height: 1.6;
}

.vram-bar {
  position: relative;
  height: 24px;
  background: var(--bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.vram-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-dim), var(--accent));
  transition: width .5s ease;
}
.vram-label {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 500;
}

/* ── Main ─────────────────────────────────────────────────────────── */

#main {
  flex: 1;
  overflow-y: auto;
  padding: 24px 32px;
}

.panel { max-width: 1000px; margin: 0 auto; }
.panel h1 { font-size: 24px; margin-bottom: 20px; font-weight: 600; }
.panel h2 { font-size: 20px; font-weight: 600; }
.panel h3 { font-size: 16px; font-weight: 600; margin-bottom: 12px; }

/* ── Forms ────────────────────────────────────────────────────────── */

.form-grid {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 24px;
  margin-bottom: 20px;
}

.form-col { display: flex; flex-direction: column; gap: 12px; }

.form-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.form-row .form-group { flex: 1; min-width: 100px; }

.form-group { display: flex; flex-direction: column; gap: 4px; }
.form-group label {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: .5px;
}
.form-group.chk {
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding-top: 20px;
}
.form-group.chk label {
  text-transform: none;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--text);
  cursor: pointer;
}

.seed-row {
  display: flex;
  gap: 4px;
  align-items: center;
}
.seed-row input { flex: 1; }

input[type="text"],
input[type="number"],
textarea,
select {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  padding: 8px 10px;
  font-size: 13px;
  font-family: inherit;
  transition: border-color .15s;
}
input:focus, textarea:focus, select:focus {
  outline: none;
  border-color: var(--accent);
}
input[type="number"] { width: 100%; }
textarea { resize: vertical; }

/* ── Range sliders ────────────────────────────────────────────────── */

.slider-group {
  position: relative;
}

.slider-value {
  font-weight: 600;
  color: var(--accent);
  font-size: 12px;
  margin-left: 4px;
  font-family: monospace;
}

.computed-value {
  font-size: 14px;
  display: inline-block;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 2px 8px;
}

.computed-hint {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
}

input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 6px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  outline: none;
  cursor: pointer;
  margin-top: 4px;
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid var(--bg-card);
  cursor: pointer;
  box-shadow: 0 1px 4px rgba(0,0,0,.3);
  transition: transform .1s, box-shadow .1s;
}

input[type="range"]::-webkit-slider-thumb:hover {
  transform: scale(1.15);
  box-shadow: 0 2px 8px rgba(88,166,255,.4);
}

input[type="range"]::-webkit-slider-thumb:active {
  transform: scale(1.05);
}

input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid var(--bg-card);
  cursor: pointer;
  box-shadow: 0 1px 4px rgba(0,0,0,.3);
}

input[type="range"]::-moz-range-track {
  height: 6px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
}

input[type="range"]:focus {
  outline: none;
}

input[type="range"]:focus::-webkit-slider-thumb {
  box-shadow: 0 0 0 3px rgba(88,166,255,.3);
}

input[type="range"]:focus::-moz-range-thumb {
  box-shadow: 0 0 0 3px rgba(88,166,255,.3);
}

/* ── Drop zone ────────────────────────────────────────────────────── */

.drop-zone {
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  padding: 20px;
  text-align: center;
  cursor: pointer;
  transition: border-color .2s, background .2s;
  min-height: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.drop-zone:hover, .drop-zone.drag-over {
  border-color: var(--accent);
  background: rgba(88,166,255,.05);
}
.drop-zone img {
  max-width: 100%;
  max-height: 260px;
  border-radius: var(--radius-sm);
  object-fit: contain;
}
.drop-zone p { color: var(--text-dim); font-size: 14px; }

/* ── LoRA ─────────────────────────────────────────────────────────── */

.lora-section {
  margin-bottom: 20px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 16px;
}
.lora-section summary {
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  margin-bottom: 8px;
}

.lora-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 8px 16px;
}
.lora-item {
  flex-direction: row !important;
  align-items: center;
  gap: 8px;
}
.lora-item label {
  flex: 1;
  font-size: 11px !important;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lora-item input { width: 70px !important; flex-shrink: 0; }

/* ── Buttons ──────────────────────────────────────────────────────── */

.btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  color: var(--text);
  font-size: 13px;
  padding: 6px 14px;
  cursor: pointer;
  transition: all .15s;
  font-family: inherit;
  white-space: nowrap;
}
.btn:hover { background: var(--bg-hover); }
.btn:disabled { opacity: .4; cursor: not-allowed; }

.btn-primary {
  background: var(--accent-dim);
  border-color: var(--accent-dim);
  color: #fff;
}
.btn-primary:hover { background: var(--accent); border-color: var(--accent); }

.btn-danger {
  border-color: #5c1a1a;
  color: var(--danger);
}
.btn-danger:hover { background: #3d0e0e; }

.btn-ghost { border-color: transparent; background: transparent; }
.btn-ghost:hover { background: var(--bg-hover); }

.btn-sm { font-size: 12px; padding: 4px 10px; }
.btn-xs { font-size: 11px; padding: 2px 6px; }
.btn-lg { font-size: 15px; padding: 10px 28px; }

.form-actions {
  display: flex;
  gap: 12px;
  margin-top: 8px;
}

/* ── Session detail ───────────────────────────────────────────────── */

.session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.session-actions { display: flex; gap: 8px; }

/* ── Timer bar ────────────────────────────────────────────────────── */

.timer-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 16px;
  font-size: 14px;
  font-family: monospace;
}
.timer-eta { color: var(--text-dim); }

/* ── Step pipeline ────────────────────────────────────────────────── */

.step-pipeline {
  display: flex;
  gap: 4px;
  margin-bottom: 16px;
  overflow-x: auto;
}

.step-card {
  flex: 1;
  min-width: 120px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px;
  text-align: center;
  position: relative;
  transition: border-color .2s;
}
.step-card[data-state="done"] { border-color: var(--success); }
.step-card[data-state="running"] { border-color: var(--warning); }
.step-card[data-state="failed"] { border-color: var(--danger); }

.step-icon {
  font-size: 20px;
  margin-bottom: 4px;
}
.step-card[data-state="done"] .step-icon { color: var(--success); }
.step-card[data-state="running"] .step-icon { color: var(--warning); }
.step-card[data-state="failed"] .step-icon { color: var(--danger); }
.step-card[data-state="pending"] .step-icon { color: var(--text-muted); }

.step-name {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .5px;
}
.step-status {
  font-size: 11px;
  color: var(--text-dim);
  margin-top: 2px;
}

/* Per-step mini progress bar */
.step-progress-mini {
  height: 3px;
  background: var(--bg);
  border-radius: 2px;
  margin-top: 6px;
  overflow: hidden;
}
.step-progress-fill {
  height: 100%;
  background: var(--accent);
  width: 0%;
  transition: width .3s ease;
  border-radius: 2px;
}
.step-card[data-state="done"] .step-progress-fill { width: 100%; background: var(--success); }
.step-card[data-state="failed"] .step-progress-fill { width: 100%; background: var(--danger); }

.step-time {
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 2px;
}
.btn-resume {
  margin-top: 6px;
  font-size: 13px;
}

/* ── VRAM detail bar ──────────────────────────────────────────────── */

.vram-detail {
  margin-bottom: 16px;
  padding: 12px 16px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.vram-detail-bar {
  position: relative;
  height: 16px;
  background: var(--bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
  margin-bottom: 6px;
}
.vram-detail-reserved {
  position: absolute;
  top: 0; left: 0;
  height: 100%;
  background: rgba(88,166,255,.2);
  transition: width .5s ease;
}
.vram-detail-allocated {
  position: absolute;
  top: 0; left: 0;
  height: 100%;
  background: linear-gradient(90deg, var(--accent-dim), var(--accent));
  transition: width .5s ease;
}
.vram-detail-labels {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-dim);
}

/* ── Progress ─────────────────────────────────────────────────────── */

.progress-section { margin-bottom: 16px; }

.progress-bar {
  height: 8px;
  background: var(--bg);
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 6px;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-dim), var(--accent));
  transition: width .3s ease;
  border-radius: 4px;
}

.progress-msg {
  font-size: 12px;
  color: var(--text-dim);
}

/* ── Info grid ────────────────────────────────────────────────────── */

.session-info {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  margin-bottom: 16px;
}
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 24px;
  font-size: 13px;
}
.info-grid strong { color: var(--text-dim); }
.error-text { color: var(--danger); }

/* ── Input image in session detail ────────────────────────────────── */

.input-image-section {
  margin-bottom: 16px;
}
.input-image-section img {
  max-width: 300px;
  max-height: 300px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  object-fit: contain;
}

/* ── Video tabs ───────────────────────────────────────────────────── */

.video-section { margin-bottom: 24px; }

.video-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 12px;
  border-bottom: 2px solid var(--border);
}
.video-tab {
  padding: 8px 20px;
  background: none;
  border: none;
  color: var(--text-dim);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  transition: all .15s;
  font-family: inherit;
}
.video-tab:hover { color: var(--text); }
.video-tab.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
}

.video-tab-content {
  display: none;
}
.video-tab-content.active {
  display: block;
}

.video-tab-content video {
  width: 100%;
  max-height: 500px;
  border-radius: var(--radius);
  background: #000;
  margin-bottom: 12px;
}
.video-actions { display: flex; gap: 8px; }

/* ── Video comparison (side-by-side) ──────────────────────────────── */

.video-compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.video-compare-col h4 {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-dim);
  text-align: center;
  margin-bottom: 8px;
}
.video-compare-col video {
  width: 100%;
  border-radius: var(--radius);
  background: #000;
}

/* ── Log viewer ───────────────────────────────────────────────────── */

.log-viewer {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 16px;
  margin-bottom: 16px;
}
.log-viewer summary {
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
}
.log-content {
  margin-top: 8px;
  max-height: 300px;
  overflow-y: auto;
  background: var(--log-bg);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  font-family: "JetBrains Mono", "Fira Code", monospace;
  font-size: 11px;
  line-height: 1.6;
  color: var(--text-dim);
  white-space: pre-wrap;
  word-break: break-all;
}
.log-line { display: block; }
.log-line-warn { color: var(--warning); }
.log-line-error { color: var(--danger); }

/* ── Toast notifications ──────────────────────────────────────────── */

.toast-container {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.toast {
  background: var(--toast-bg);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 20px;
  font-size: 13px;
  box-shadow: var(--shadow);
  pointer-events: auto;
  animation: toastIn .3s ease-out;
  max-width: 400px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.toast.toast-success { border-left: 3px solid var(--success); }
.toast.toast-error { border-left: 3px solid var(--danger); }
.toast.toast-warning { border-left: 3px solid var(--warning); }
.toast.toast-info { border-left: 3px solid var(--accent); }

.toast.toast-out {
  animation: toastOut .3s ease-in forwards;
}

@keyframes toastIn {
  from { opacity: 0; transform: translateX(40px); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes toastOut {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(40px); }
}

/* ── Scrollbar ────────────────────────────────────────────────────── */

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

/* ── Responsive ───────────────────────────────────────────────────── */

@media (max-width: 900px) {
  .form-grid { grid-template-columns: 1fr; }
  #sidebar { width: 220px; min-width: 220px; }
  .video-compare { grid-template-columns: 1fr; }
}

/* ── Animations ───────────────────────────────────────────────────── */

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .5; }
}
.step-card[data-state="running"] .step-icon {
  animation: pulse 1.5s ease-in-out infinite;
}
